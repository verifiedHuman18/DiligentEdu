generator client {
  provider             = "prisma-client-py"
  interface            = "sync"
  recursive_type_depth = 5
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id // Firebase UID
  email       String   @unique
  name        String?
  role        String   // "student" or "teacher"
  subject     String?  // e.g. "science", "math"
  class_level Int?     // Only applicable for students (e.g. 9 or 10)
  createdAt   DateTime @default(now())
}

model QuizAttempt {
  quiz_id         String             @id
  student_id      String
  class_level     Int
  chapter         String
  chapter_number  Int?
  difficulty      String
  score           Int
  total_questions Int
  percentage      Float
  timestamp       String
  responses       QuestionResponse[]
}

model QuestionResponse {
  id             Int          @id @default(autoincrement())
  quiz_id        String
  question_id    String
  question_text  String?
  chapter        String
  difficulty     String
  user_answer    String?
  correct_answer String?
  is_correct     Int
  source_pages   String?
  quiz           QuizAttempt  @relation(fields: [quiz_id], references: [quiz_id], onDelete: Cascade)
}

model TeacherActionPlan {
  id            Int      @id @default(autoincrement())
  student_id    String
  class_level   Int
  plan_data     String
  teacher_notes String?
  updated_at    String

  @@unique([student_id, class_level])
}
