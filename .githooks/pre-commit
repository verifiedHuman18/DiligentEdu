#!/usr/bin/env bash
# ==============================================================================
# Git Pre-Commit Hook for DiligentEdu
# Available to all collaborators via: git config core.hooksPath .githooks
# Or via pre-commit framework: uv run pre-commit install
# ==============================================================================

set -e

# Color definitions
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo -e "${BLUE}🔍 Running DiligentEdu Pre-Commit Quality Checks...${NC}"

# Check if pre-commit is available and configured
if command -v pre-commit &> /dev/null; then
    pre-commit run --hook-stage pre-commit
elif command -v uv &> /dev/null && uv run which pre-commit &> /dev/null 2>&1; then
    uv run pre-commit run --hook-stage pre-commit
else
    # Fallback to direct Ruff lint and formatting check if pre-commit is not found
    echo -e "${YELLOW}⚠️  'pre-commit' tool not found in PATH, falling back to Ruff...${NC}"

    if command -v ruff &> /dev/null; then
        RUFF_CMD="ruff"
    elif command -v uv &> /dev/null; then
        RUFF_CMD="uv run ruff"
    elif [ -f ".venv/bin/ruff" ]; then
        RUFF_CMD=".venv/bin/ruff"
    else
        echo -e "${RED}❌ Neither 'pre-commit', 'uv', nor 'ruff' were found.${NC}"
        echo -e "${YELLOW}👉 Run: uv sync && uv run pre-commit install${NC}"
        exit 1
    fi

    echo -e "${BLUE}Running: ${RUFF_CMD} check...${NC}"
    $RUFF_CMD check .

    echo -e "${BLUE}Checking code formatting...${NC}"
    $RUFF_CMD format --check .
fi

echo -e "${GREEN}✅ All pre-commit linter checks passed!${NC}"
exit 0
